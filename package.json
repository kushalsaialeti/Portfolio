{
  "name": "portfolio-workspace",
  "private": true,
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix backend install",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run install:all && npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test",
    "start": "npm --prefix backend start",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  }
}

